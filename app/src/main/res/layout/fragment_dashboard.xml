<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#009688"
    tools:context=".MainActivity">

    <!-- FOTO PROFIL -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profileImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/profil"
        app:shapeAppearanceOverlay="@style/CircleImageStyle"
        app:strokeColor="@color/white"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.06" />

    <TextView
        android:id="@+id/txtNamaUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/profileImage"
        app:layout_constraintStart_toStartOf="@id/profileImage"
        app:layout_constraintEnd_toEndOf="@id/profileImage" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Datang"
        android:textColor="#FED006"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtNamaUser"
        app:layout_constraintStart_toStartOf="@id/txtNamaUser"
        app:layout_constraintEnd_toEndOf="@id/txtNamaUser" />

    <!-- AREA BAWAH -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bottom_background_light_green"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- SCROLL AGAR RESPONSIF -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- GRID MENU -->
                <GridLayout
                    android:id="@+id/gridMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="16dp">

                    <!-- ===== KARTU 1 ===== -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cardLihatKonsultasi"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/white_btn_background"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/bgIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/circle_green" />

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/list_konsul"
                                app:tint="@color/white" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lihat Janji"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/teal_400"
                            android:paddingTop="4dp" />
                    </LinearLayout>

                    <!-- ===== KARTU 2 ===== -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cardBeliObat"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/white_btn_background"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/bgIcon2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/circle_green" />

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/btn_1"
                                app:tint="@color/white" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Beli Obat"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/teal_400"
                            android:paddingTop="4dp" />
                    </LinearLayout>

                    <!-- ===== KARTU 3 ===== -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cardProfil"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/white_btn_background"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/circle_green" />

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="46dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:srcCompat="@drawable/ic_person"
                                app:tint="@color/white" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Profil"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/teal_400"
                            android:paddingTop="4dp" />
                    </LinearLayout>

                    <!-- ===== BARIS 2 (CENTERED) ===== -->
                    <!-- ===== BARIS 2 (CENTERED 2 CARD) ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_columnSpan="3"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Buat Janji -->
                        <LinearLayout
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cardBuatJanji"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/white_btn_background"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:srcCompat="@drawable/circle_green" />

                                <ImageView
                                    android:layout_width="38dp"
                                    android:layout_height="46dp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:srcCompat="@drawable/tambah_appointment"
                                    app:tint="@color/white" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Buat Janji"
                                android:textAlignment="center"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="@color/teal_400"
                                android:paddingTop="4dp" />
                        </LinearLayout>

                        <!-- Prediksi WQI -->
                        <LinearLayout
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cardPrediksiWQI"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:background="@drawable/white_btn_background"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:srcCompat="@drawable/circle_green" />

                                <ImageView
                                    android:layout_width="38dp"
                                    android:layout_height="46dp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:srcCompat="@drawable/water_drop_24px"
                                    app:tint="@color/white" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Prediksi WQI"
                                android:textAlignment="center"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="@color/teal_400"
                                android:paddingTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>




                    <!-- Spacer agar grid genap -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1" />

                </GridLayout>

                <!-- BANNER APPOINTMENT -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="32dp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="16dp"
                    android:background="@drawable/green_banner_background">


                <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daftar Appointment"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- ✅ INI YANG HILANG -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAppointments"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:nestedScrollingEnabled="false"
                        app:layout_constraintTop_toBottomOf="@id/textView4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />


                    <!-- ✅ INI JUGA WAJIB -->
                    <TextView
                        android:id="@+id/tvNoAppointments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada appointment hari ini"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/textView4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
