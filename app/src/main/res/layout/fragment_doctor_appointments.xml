<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header_doctor"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_appointments_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permintaan Janji"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_appointments_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar reservasi yang menunggu konfirmasi"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- RecyclerView untuk daftar appointment admin -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminAppointments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>
    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada reservasi"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#888888"
        android:visibility="gone" />

</LinearLayout>
